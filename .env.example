# Ingredion Agentic AI Factory — copy to .env and fill in. Never commit .env.
# Platform: the Ingredion Google Cloud project (SOW No. 07 redline v2, 20 Oct 2026). Nothing else.

# Shared secret that reviewer and operator clients send in the X-API-Key header. REQUIRED.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INGREDION_API_KEY=

# Which agents this api instance serves: order-intake,prebill (both on a laptop; one per Cloud Run service)
INGREDION_AGENTS=order-intake,prebill

# ── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Credentials: the Cloud Run service account, or GOOGLE_APPLICATION_CREDENTIALS locally.

# Model: the Gemini model Ingredion allow-lists on Vertex AI (default gemini-3.8-flash, GA since 2 Sep 2026)
VERTEX_MODEL=gemini-3.8-flash
VERTEX_CONTROLLED_GENERATION=on          # response schema; falls back to JSON mode if rejected

# Guardrails: Model Armor template (Ingredion-owned). Without it only the pattern guard runs (Dev only).
MODEL_ARMOR_TEMPLATE=projects/<project>/locations/us-central1/templates/<template>

# Layout for PDFs and scans: Document AI processor (Enterprise Document OCR). Unset = text, Excel and Word only.
DOCUMENT_AI_PROCESSOR=projects/<project>/locations/us/processors/<processor-id>

# Outlook drafts for the reviewer (Microsoft Graph, drafts only, shared mailbox)
GRAPH_DRAFT_MAILBOX=orders@ingredion.example

# Order Intake mode: primary (all cases, cohort by cohort) | fallback (RPA failure record only)
ORDER_INTAKE_MODE=primary

# ── Data platform ────────────────────────────────────────────────────────────
# stub = in-memory Dev systems (default) | gold = BigQuery gold tables + the files bucket
INGREDION_PLATFORM=stub
# GOLD_PROJECT=                           # defaults to GOOGLE_CLOUD_PROJECT
# GOLD_DATASET_SUFFIX=_dev                # the data team's per-environment suffix; empty in Prod
# GOLD_MAX_AGE_MINUTES=                   # global staleness override; unset = per-table limits in factory/platform/schema.py
# FILES_BUCKET=ingredion-files-dev        # PO files, contracts, rate files (read by pointer and hash)
# Scheduled CSV extracts for sources without a read interface (rate files, TermSync); take precedence when set
# EXTRACT_BUCKET=ingredion-landing-dev
# EXTRACT_DIR=./extracts
# Evidence buckets (one per agent) and outcome datasets (one per agent); unset = in memory
# EVIDENCE_BUCKET_ORDER_INTAKE=ingredion-agent-a-evidence-dev
# EVIDENCE_BUCKET_PREBILL=ingredion-agent-b-evidence-dev
# EVIDENCE_DIR_ORDER_INTAKE=./evidence/a   # local alternative for Dev
# OUTCOMES_DATASET_ORDER_INTAKE=agent_a_outcomes
# OUTCOMES_DATASET_PREBILL=agent_b_outcomes

# ── api ⇄ worker (Pub/Sub). Unset = the api runs cases inline (Dev) ──────────
# WORK_TOPIC_ORDER_INTAKE=agent-a-work
# WORK_SUBSCRIPTION_ORDER_INTAKE=agent-a-work-worker
# WORK_TOPIC_PREBILL=agent-b-work
# WORK_SUBSCRIPTION_PREBILL=agent-b-work-worker
# Pub/Sub push authentication on /events/*. Unset = the service key stands in (Dev).
# PUBSUB_PUSH_AUDIENCE=https://<api service url>/events
# PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@<project>.iam.gserviceaccount.com

# ── Stores and controls ──────────────────────────────────────────────────────
# Shared stores (audit, review queue, claims, kill switch, cases). Unset = in-memory, Dev only.
# INGREDION_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ingredion
# Emergency stop without a database: on | off
INGREDION_KILL_SWITCH=off

# ── HTTP ─────────────────────────────────────────────────────────────────────
INGREDION_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
